{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MindsWall",
  "version": "1.0.0",
  "identifier": "com.mindswall.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MindsWall",
        "width": 1120,
        "height": 760,
        "minWidth": 680,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NamchokGithub",
    "copyright": "© 2026 Namchok Singhachai. MIT License.",
    "category": "Utility",
    "shortDescription": "Local-first wallpaper manager for Windows",
    "longDescription": "MindsWall changes your Windows wallpaper from your own folders, with a slideshow, per-monitor wallpapers, combined layouts, and a tray icon. It works offline and needs no administrator rights.",
    "homepage": "https://github.com/namchokGithub/mindswall",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
